                <img
                  alt="Boy holding oversized envelope"
                  src="https://assets.stg.env.maisonette.com/images/email-subscription.png"
                  srcset="
                        https://assets.stg.env.maisonette.com/images/email-subscription-2x.png 2x,
                        https://assets.stg.env.maisonette.com/images/email-subscription-3x.png 3x
                      "
                />
              </figure>
            </div>
            <h1
              class="emotion-17 emotion-18"
