  .emotion-148 {
    display: block;
  }
}

.emotion-148 ol ol {
  margin-left: 2rem;
}

.emotion-150 {
  font-family: GT Pressura Web,Arial Narrow,Arial,sans-serif;
  font-size: 1.2rem;
  border-bottom: 1px solid #3150A2;
  color: #3150A2;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
  -ms-flex-direction: column;
  flex-direction: column;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
  -ms-flex-pack: center;
  justify-content: center;
  -webkit-letter-spacing: 0.2rem;
  -moz-letter-spacing: 0.2rem;
  -ms-letter-spacing: 0.2rem;
  letter-spacing: 0.2rem;
  margin-bottom: 1rem;
  min-height: 4rem;
  text-transform: uppercase;
}

.emotion-152 {
  font-family: GT Walsheim Web,Helvetica,Trebuchet MS,sans-serif;
  font-size: 1.2rem;
  color: #3150A2;
  cursor: pointer;
  display: block;
  line-height: 3rem;
  -webkit-text-decoration: none;
  text-decoration: none;
  -webkit-transition: color 400ms;
  transition: color 400ms;
}

.emotion-152:hover {
  color: #3150A2;
}

.emotion-154 {
  position: relative;
  outline: 0;
}

.emotion-154 ol {
  -webkit-transition: all 400ms;
  transition: all 400ms;
}

.emotion-154 summary {
  outline: none;
  line-height: 3rem;
}

.emotion-154 summary::after {
  background-image: url(data:image/svg+xml;base64,CiAgICA8c3ZnIHhtbG5zPSdodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZycgdmVyc2lvbj0nMS4xJyB2aWV3Ym94PSIwIDAgOCA0Ij4KICAgICAgPHBhdGggZmlsbD0iIzlDQjFEQyIgZD0iTTAgMCBMNCA0IEw4IDAgWiIgLz4KICAgIDwvc3ZnPgogIA==);
  background-position: right 1px center;
  background-repeat: no-repeat;
  background-size: 8px 4px;
  content: '';
  position: absolute;
  right: 0;
  height: 3rem;
  width: 100%;
  -webkit-transition: background-image 200ms;
  transition: background-image 200ms;
}

.emotion-154 summary::-webkit-details-marker,
.emotion-154 summary::before {
  display: none!important;
}

.emotion-154[open]>summary::after {
  background-image: url(data:image/svg+xml;base64,CiAgICA8c3ZnIHhtbG5zPSdodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZycgdmVyc2lvbj0nMS4xJyB2aWV3Ym94PSIwIDAgOCA0Ij4KICAgICAgPHBhdGggZmlsbD0iIzlDQjFEQyIgZD0iTTAgNCBMOCA0IEw0IDAgWiIgLz4KICAgIDwvc3ZnPgogIA==);
  background-position: right 1px center;
  background-repeat: no-repeat;
  background-size: 8px 4px;
}

.emotion-156 {
