<body>
    <div>
      <div
        class="emotion-0 emotion-1"
        data-test-id="ProductDetails"
      >
        <div
          class="emotion-2 emotion-3"
        >
          <div
            class="emotion-4 emotion-5"
            data-test-id="ProductBadge"
          >
            <span
              class="emotion-6 emotion-7"
            >
              Selling Fast
            </span>
          </div>
        </div>
        <header
          class="emotion-8 emotion-9"
          data-test-id="ProductHeader"
        >
          <a
            class="emotion-10 emotion-11"
            href="/brands/mr-christmas"
          >
            <h2
              class="emotion-12 emotion-13"
            >
              Mr. Christmas
            </h2>
          </a>
          <a
            class="emotion-10 emotion-11"
            href="/product/nostalgic-tree-nightlight-pink"
          >
            <h1
              class="emotion-16 emotion-17"
            >
              Nostalgic Tree Nightlight, Pink
            </h1>
          </a>
          <div
            class="emotion-18 emotion-19"
            tabindex="0"
          >
            $39.99
          </div>
          <div
            class=" emotion-20 emotion-21"
            data-test-id="PromoMessaging"
            data-vwo-id="PromoMessaging"
          >
            <span
              class="emotion-22 emotion-23"
            >
              Additional 5% OFF, 10% OFF $75+, 15% OFF $300+ with BLACKFRIDAY2023 promo
            </span>
          </div>
          <dl
            class="emotion-24 emotion-25"
          >
            <dt
              class="emotion-26 emotion-27"
            >
              or 4 interest-free payments
              
            </dt>
            <dd
              class="emotion-28 emotion-29"
            >
              <div
                class="emotion-30 emotion-31"
              >
                <div
                  class="emotion-32 emotion-33"
                >
                  <div
                    class="emotion-34 emotion-170"
                    data-pp-amount="39.99"
                    data-pp-message="true"
                    data-pp-style-layout="text"
                    data-pp-style-logo-type="inline"
                    data-pp-style-text-align="left"
                    data-pp-style-text-color="black"
                  />
                  <afterpay-placement
                    data-amount="39.99"
                    data-badge-theme="white-on-black"
                    data-currency="USD"
                    data-intro-text="Pay in"
                    data-locale="en_US"
                    data-modal-link-style="learn-more-text"
                    data-modal-theme="white"
                    data-size="xs"
                  />
                </div>
              </div>
            </dd>
          </dl>
        </header>
        <div
          class=" emotion-36 emotion-37"
          data-test-id="ProductRestrictions"
        >
          <span
            class="emotion-38 emotion-39"
          >
            Usually ships within  2 days
          </span>
        </div>
        <div
          class="emotion-40 emotion-41"
        >
          <form
            class="emotion-42 emotion-43"
            id="add-to-cart-form"
          >
            <label
              class="emotion-44 emotion-45"
              for="product-add-to-cart-quantity-select"
              tabindex="1"
            />
            <div
              class="emotion-46 emotion-47"
            >
              <div
                class="emotion-48 emotion-49"
              >
                <select
                  class="emotion-50 emotion-51"
                  id="product-add-to-cart-quantity-select"
                  name="quantity"
                >
                  <option>
                    1
                  </option>
                  <option>
                    2
                  </option>
                  <option>
                    3
                  </option>
                  <option>
                    4
                  </option>
                  <option>
                    5
                  </option>
                  <option>
                    6
                  </option>
                  <option>
                    7
                  </option>
                  <option>
                    8
                  </option>
                  <option>
                    9
                  </option>
                  <option>
                    10
                  </option>
                </select>
              </div>
              <div
                class="emotion-52 emotion-476"
              >
                <label
                  class="emotion-54 emotion-55"
                  for="product-add-to-cart-button"
                  tabindex="1"
                >
                  Add to Bag Button
                </label>
                <button
                  class="emotion-56 emotion-57 emotion-58"
                  data-test-id="add_to_cart"
                  id="product-add-to-cart-button"
                  type="submit"
                >
                  Add to bag
                </button>
              </div>
            </div>
            <label
              class="emotion-59 emotion-60"
              for="add-to-wishlist-button"
              tabindex="0"
            >
              Add to Wishlist Button
               is disabled. Sign in to add this to your wishlist.
            </label>
            <button
              class=" emotion-61 emotion-62 emotion-63 emotion-58"
