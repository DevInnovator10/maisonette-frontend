<div>
    <section
      class="emotion-0 emotion-1"
      data-test-id="SizeGuide"
    >
      <h1
        class="emotion-2 emotion-3"
      >
        Clothing + Shoes Size Chart
      </h1>
      <p
        class="emotion-4 emotion-5"
      >
        Because sizing and cut will vary between brands, please use this chart as a general guide. If you are between sizes or need assistance selecting the proper size, please contact
         
        <a
          href="mailto:customercare@maisonette.com"
        >
          customer care
        </a>
      </p>
      <nav
        class="emotion-6 emotion-7"
      >
        <button
          class="emotion-8 emotion-9"
          data-test-id="SizeGuide"
          type="button"
        >
          Baby
        </button>
        <button
          class="emotion-8 emotion-9"
          data-test-id="SizeGuide"
          type="button"
        >
          Toddler
        </button>
        <button
          class="emotion-8 emotion-9"
          data-test-id="SizeGuide"
          type="button"
        >
          Boys
        </button>
        <button
          class="emotion-8 emotion-9"
          data-test-id="SizeGuide"
          type="button"
        >
          Girls
        </button>
        <button
          class="emotion-8 emotion-9"
          data-test-id="SizeGuide"
          type="button"
        >
          Shoes
        </button>
        <button
          class="emotion-18 emotion-9"
          type="button"
        >
          Measuring
        </button>
      </nav>
      <div
        data-test-id="SizeGuideMeasuring"
      >
        <nav
          class="emotion-20 emotion-21"
        >
          <button
            class="emotion-22 emotion-23"
            type="button"
          >
            Clothing
          </button>
          <button
            class="emotion-24 emotion-23"
            type="button"
          >
            Shoes
          </button>
        </nav>
        <select
          class="emotion-26 emotion-27"
          name="size-select-mobile"
        >
          <option
            value="clothing"
          >
            Clothing
          </option>
          <option
            value="shoes"
          >
            Shoes
          </option>
        </select>
        <div
          class="emotion-28 emotion-29"
        >
          <figure
            class="emotion-30 emotion-31"
          >
            <img
              alt="Size Guide Shoes"
              src="https://assets.stg.env.maisonette.com/images/size-guide-clothing.jpg"
            />
          </figure>
          <div
            class="emotion-32 emotion-33"
          >
            <label
              class="emotion-34 emotion-35"
            >
              Chest
            </label>
            <p
              class="emotion-36 emotion-35"
            >
              Measure a loop just above your child’s armpits, passing the tape across the fullest part of the chest and around the shoulder blades.
            </p>
          </div>
          <div
            class="emotion-38 emotion-39"
          >
            <label
              class="emotion-34 emotion-35"
            >
              Waist
            </label>
            <p
              class="emotion-36 emotion-35"
            >
              Measure a loop just above your child’s hip bone, around the natural waistline.
            </p>
          </div>
        </div>
      </div>
    </section>
