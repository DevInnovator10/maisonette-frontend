<div>
    <div
      class="emotion-0 emotion-1"
    >
      <form
        class="emotion-2 emotion-3"
        id="add-to-cart-form"
      >
        <p
          class="emotion-4 emotion-5"
        >
          Size
          :
          <span
            class="emotion-6 emotion-7"
          >
            Select a size
          </span>
        </p>
        <div
          class="emotion-8 emotion-9"
        >
          <label
            class="emotion-10 emotion-11"
            data-test-id="ProductAdd"
            for="product-option-0-3M"
            tabindex="0"
          >
            <input
              aria-label="0-3M"
              class="emotion-12 emotion-13"
              id="product-option-0-3M"
              name="product-option"
              type="radio"
              value="0-3M"
            />
            0-3M
          </label>
          <label
            class="emotion-14 emotion-11"
            data-test-id="ProductAdd"
            disabled=""
            for="product-option-3-6M"
            tabindex="0"
          >
            <input
              aria-label="3-6M option is out of stock."
              class="emotion-12 emotion-13"
              id="product-option-3-6M"
              name="product-option"
              type="radio"
              value="3-6M"
            />
            3-6M
