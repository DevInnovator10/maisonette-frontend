            6-9M
          </label>
        </div>
        <main
          class="emotion-22 emotion-23"
          data-test-id="Component"
          style="overflow: hidden;"
        >
          <button
            aria-label="close modal"
            class="emotion-24 emotion-25 emotion-26"
            id="close-modal"
            type="button"
          >
            <svg
              class="emotion-27 emotion-28"
              data-test-id="Icon"
            />
          </button>
          <div
            class="emotion-29 emotion-30"
            data-test-id="Content"
          />
        </main>
        <label
          class="emotion-31 emotion-32"
          for="product-add-to-cart-quantity-select"
          tabindex="0"
        >
          Quantity Select is disabled. Please select a Size to enable.
        </label>
        <div
          class="emotion-33 emotion-34"
        >
          <div
            class="emotion-35 emotion-36"
          >
            <select
              class="emotion-37 emotion-38"
              disabled=""
              id="product-add-to-cart-quantity-select"
              name="quantity"
            />
          </div>
          <div
            class="emotion-39 emotion-346"
          >
            <label
              class="emotion-41 emotion-42"
              for="product-add-to-cart-button"
              tabindex="1"
            >
              Add to Bag Button
            </label>
            <button
              class="emotion-43 emotion-44 emotion-26"
              data-test-id="add_to_cart"
              id="product-add-to-cart-button"
              type="submit"
            >
              Add to bag
            </button>
          </div>
        </div>
        <label
          class="emotion-46 emotion-47"
          for="add-to-wishlist-button"
          tabindex="0"
        >
          Add to Wishlist Button
           is disabled. Sign in to add this to your wishlist.
        </label>
        <button
          class=" emotion-48 emotion-49 emotion-50 emotion-26"
          data-test-id="IconButton"
          disabled=""
          id="add-to-wishlist-button"
          type="button"
        >
          <svg
            class="emotion-52 emotion-53"
          />
          <i
            class="emotion-54 emotion-55"
          >
            Sign in to add this to your wishlist!
          </i>
        </button>
      </form>
      <div
        class="emotion-56 emotion-57"
        data-test-id="WaitlistEmail"
      >
        <form
          action="#"
          class="emotion-58 emotion-59"
          data-height="0"
          data-test-id="WaitlistEmail"
        >
          <div
            class="emotion-60 emotion-61"
          >
            <p
              class="emotion-62 emotion-63"
              id="waitlist-message"
            >
              <b
                class="emotion-64 emotion-65"
              >
                Oh no! It's out of stock!
              </b>
              Join the waitlist and we'll email you as soon as this product or size becomes available again.
            </p>
            <label
              class="emotion-66 emotion-67"
              for="waitlist-email"
            >
              Waitlist Email Input
            </label>
            <div
              class="emotion-68 emotion-69"
              data-test-id="WaitlistEmail"
            >
              <input
                aria-labelledby="waitlist-message waitlist-email"
                autocomplete="email"
                class="emotion-70 emotion-71 emotion-72"
                data-test-id="InputEmail"
                disabled=""
                id="waitlist-email"
                name="waitlist-email"
                placeholder="Email Address"
                type="email"
                value=""
              />
            </div>
            <button
              class="emotion-73 emotion-74 emotion-26"
              type="submit"
            >
              Email when Available
            </button>
          </div>
        </form>
      </div>
    </div>
